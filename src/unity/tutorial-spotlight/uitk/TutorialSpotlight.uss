/* 튜토리얼 스포트라이트 — Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080.
   한글이 네모로 보이면 Panel Settings 의 Text Settings 에 한글 글꼴(Font Asset)을 넣는다.
   UI Toolkit 에는 마스크 구멍이 없으므로 '구멍 바깥 네 장(.block)' 이 어둡게 칠하면서 입력도 막는다.
   USS 에 box-shadow 가 없어 구멍 테두리(.ring)는 border 로만 그린다. */

.game,
.tutorial {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ───── 게임 화면 ───── */
.tabs {
    position: absolute;
    left: 48px;
    bottom: 36px;
    flex-direction: row;
}

.tab {
    width: 150px;
    height: 128px;
    margin-right: 16px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(47, 74, 102);
    background-color: rgb(13, 26, 40);
    color: rgb(234, 242, 251);
    font-size: 24px;
}

.sortie {
    position: absolute;
    right: 72px;
    bottom: 44px;
    width: 360px;
    height: 130px;
    border-radius: 20px;
    border-width: 0;
    background-color: rgb(255, 150, 70);
    color: rgb(42, 18, 0);
    font-size: 44px;
    -unity-font-style: bold;
}

.drawer {
    position: absolute;
    right: 0;
    top: 104px;
    bottom: 200px;
    width: 620px;
    padding: 28px 32px;
    background-color: rgb(19, 32, 47);
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
    translate: 110% 0;
    transition-property: translate;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.drawer--open {
    translate: 0 0;
}

.shop {
    position: absolute;
    left: 580px;
    top: 140px;
    width: 760px;
    height: 640px;
    padding: 26px 30px;
    background-color: rgb(19, 32, 47);
    border-radius: 24px;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.shop--open {
    opacity: 1;
    visibility: visible;
}

.shop-list {
    flex-grow: 1;
}

.panel-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(234, 242, 251);
    margin-bottom: 16px;
}

.row {
    font-size: 26px;
    color: rgb(214, 226, 238);
    padding: 16px 18px;
    margin-bottom: 10px;
    border-radius: 12px;
    background-color: rgb(11, 22, 34);
}

.primary {
    height: 84px;
    margin-top: 12px;
    border-radius: 14px;
    border-width: 0;
    background-color: rgb(94, 230, 201);
    color: rgb(6, 42, 36);
    font-size: 30px;
    -unity-font-style: bold;
}

.item {
    height: 104px;
    margin-bottom: 12px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(47, 74, 102);
    background-color: rgb(11, 22, 34);
    color: rgb(234, 242, 251);
    font-size: 26px;
    -unity-text-align: middle-left;
    padding-left: 22px;
}

/* ───── 튜토리얼 ───── */
.block {
    position: absolute;
    background-color: rgba(2, 6, 12, 0.72);
}

.ring {
    position: absolute;
    border-width: 4px;
    border-color: rgb(94, 230, 201);
}

/* 손가락 대신 '누르는 점' — 비트맵 없이 원으로 */
.hand {
    position: absolute;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    margin-top: -32px;
    border-radius: 32px;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.35);
    display: none;
}

.hand--on {
    display: flex;
}

.tip {
    position: absolute;
    width: 560px;
    padding: 22px 26px;
    border-radius: 18px;
    background-color: rgb(244, 247, 251);
}

.tip__head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.tip__title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(16, 20, 28);
}

.tip__progress {
    font-size: 22px;
    color: rgb(83, 96, 111);
}

.tip__body {
    font-size: 26px;
    color: rgb(16, 20, 28);
    white-space: normal;
}

.skip {
    position: absolute;
    right: 40px;
    top: 120px;
    height: 56px;
    padding: 0 22px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(5, 10, 16, 0.9);
    color: rgb(234, 242, 251);
    font-size: 22px;
}
