/* 조준점 + 적중 표시 — UI Toolkit 스타일.
   USS 에는 box-shadow 가 없으므로 외곽선은 border 로 만든다 (요소 크기 = 색 영역 + 테두리 2px × 2). */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* 0×0 기준점. 자식은 모두 이 점을 중심으로 절대 배치 */
.reticle {
    width: 0;
    height: 0;
}

.reticle__dot,
.reticle__arm {
    position: absolute;
    background-color: rgb(244, 247, 251);
    border-width: 2px;
    border-color: rgba(6, 10, 16, 0.9);
    /* 적 조준 색 전환 0.06초 */
    transition-property: background-color;
    transition-duration: 0.06s;
    transition-timing-function: linear;
}

.reticle__dot {
    width: 12px;
    height: 12px;
    left: -6px;
    top: -6px;
}

/* 팔은 중심(0, 0)에 붙여 두고, 간격은 C# 에서 translate 로만 바꾼다 */
.reticle__arm--v {
    width: 9px;
    height: 34px;
    left: -4.5px;
    top: 0;
}
.reticle__arm--h {
    width: 34px;
    height: 9px;
    left: 0;
    top: -4.5px;
}

.reticle--hostile .reticle__dot,
.reticle--hostile .reticle__arm {
    background-color: rgb(255, 90, 79);
}

/* 적 조준: 색만이 아니라 모양도 — 점은 마름모(45° 회전), 팔은 9 → 11px (테두리 포함) */
.reticle__dot {
    transition-property: background-color, rotate, scale;
    transition-duration: 0.06s, 0.06s, 0.06s;
}
.reticle--hostile .reticle__dot {
    rotate: 45deg;
    scale: 1.3 1.3;
}
.reticle--hostile .reticle__arm--v {
    width: 11px;
    left: -5.5px;
}
.reticle--hostile .reticle__arm--h {
    height: 11px;
    top: -5.5px;
}

/* ── 적중 표시 ── */
.hm {
    position: absolute;
    width: 0;
    height: 0;
}

.hm__lines {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
}

.hm__arm {
    position: absolute;
    width: 0;
    height: 0;
}
.hm__arm--tl { rotate: 225deg; }
.hm__arm--tr { rotate: 315deg; }
.hm__arm--bl { rotate: 135deg; }
.hm__arm--br { rotate: 45deg; }

/* 일반 적중: 가는 X */
.hm__line {
    position: absolute;
    left: 16px;
    top: -4.5px;
    width: 28px;
    height: 9px;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgba(6, 10, 16, 0.9);
}

/* 약점 적중: 굵고 길고 노랗게 (모양 + 색) */
.hm--crit .hm__line {
    top: -6.5px;
    width: 42px;
    height: 13px;
    background-color: rgb(255, 210, 63);
}

/* 모양 구분을 끈 약점 적중: 색만 다르다 (비교용 나쁜 예) */
.hm--crit-flat .hm__line {
    background-color: rgb(255, 210, 63);
}

/* 처치 원: 크기 1 → 2배, 투명도는 C# 에서 */
.hm__ring {
    position: absolute;
    left: -46px;
    top: -46px;
    width: 92px;
    height: 92px;
    border-radius: 46px;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
    opacity: 0;
}
.hm--crit .hm__ring,
.hm--crit-flat .hm__ring {
    border-color: rgb(255, 210, 63);
}
