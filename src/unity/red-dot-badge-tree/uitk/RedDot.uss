/* 레드닷 — Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080.
   한글이 네모로 보이면 Panel Settings 의 Text Settings 에 한글 글꼴(Font Asset)을 넣는다.
   켜짐/꺼짐은 display 대신 scale 0 ↔ 1 — display: none 에는 transition 이 동작하지 않는다. */

.nav {
    position: absolute;
    left: 40px;
    top: 140px;
}

.nav-btn {
    width: 220px;
    height: 150px;
    margin-bottom: 18px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgb(47, 74, 102);
    background-color: rgb(13, 26, 40);
    color: rgb(234, 242, 251);
    font-size: 26px;
}

.window {
    position: absolute;
    left: 300px;
    top: 140px;
    width: 1060px;
    bottom: 40px;
    padding: 26px 30px;
    border-radius: 24px;
    background-color: rgb(19, 32, 47);
}

.window__title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(234, 242, 251);
    margin-bottom: 18px;
}

.tabs {
    flex-direction: row;
    margin-bottom: 18px;
}

.tab {
    height: 64px;
    padding: 0 34px;
    margin-right: 12px;
    border-radius: 14px;
    background-color: rgb(11, 22, 34);
    color: rgb(183, 199, 216);
    font-size: 26px;
}

.list {
    flex-grow: 1;
}

.row {
    flex-direction: row;
    align-items: center;
    height: 92px;
    padding: 0 20px;
    margin-bottom: 12px;
    border-radius: 14px;
    background-color: rgb(11, 22, 34);
}

.row__label {
    flex-grow: 1;
    font-size: 26px;
    color: rgb(234, 242, 251);
}

.row__claim {
    height: 60px;
    min-width: 130px;
    border-radius: 12px;
    background-color: rgb(94, 230, 201);
    color: rgb(6, 42, 36);
    font-size: 24px;
}

/* ───── 배지 ───── */
.red-dot {
    position: absolute;
    right: -6px;
    top: -6px;
    min-width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 3px;
    border-color: rgb(11, 22, 34);
    background-color: rgb(255, 59, 78);
    align-items: center;
    justify-content: center;
    scale: 0 0;
    transition-property: scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.red-dot--on {
    scale: 1 1;
}

/* 숫자 배지는 커진다 */
.red-dot--count {
    min-width: 36px;
    height: 36px;
    border-radius: 18px;
    padding: 0 6px;
}

.red-dot__count {
    display: none;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    padding: 0;
    margin: 0;
}

.red-dot--count .red-dot__count {
    display: flex;
}

/* 홍보처럼 약한 점 */
.red-dot--subtle {
    background-color: rgb(143, 163, 184);
    min-width: 14px;
    height: 14px;
}
