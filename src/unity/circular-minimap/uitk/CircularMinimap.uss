/* Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080 기준 픽셀 값.
   USS 에는 gradient·box-shadow·filter 가 없으므로 단색 테두리와 이미지(resource)로만 그린다. */

.minimap {
    position: absolute;
    left: 96px;
    top: 76px;
    width: 300px;
    height: 300px;
}

/* 둥근 마스크: border-radius 와 overflow:hidden 을 함께 줘야 원으로 잘린다 (스텐실 처리) */
.minimap__mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    overflow: hidden;
    background-color: rgba(8, 12, 18, 0.35);
}

.minimap__pivot {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
}

/* 북쪽이 위인 지도 텍스처 (Resources/Minimap/MapBaked).
   크기·기준 위치는 C# 시작 시 월드 범위로 계산하고, 이동은 매 프레임 translate 로 준다 */
.minimap__map {
    position: absolute;
    left: 0;
    top: 0;
    width: 1275px;
    height: 1275px;
    background-image: resource("Minimap/MapBaked");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.75;
}

.minimap__cone {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* 원 중심에 0 크기 기준점 — 아이콘은 C# 에서 translate 로 중심 기준 오프셋에 놓는다 */
.minimap__icons,
.minimap__edge {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
}

.icon {
    position: absolute;
}

/* 위계 1: 주요 목표 — 가장 큼, 앰버 과녁 (바깥 고리 + 채운 원) */
.icon--primary {
    left: -22px;
    top: -22px;
    width: 44px;
    height: 44px;
    border-width: 5px;
    border-color: rgb(255, 181, 46);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
}

.icon--primary > .icon__core {
    width: 18px;
    height: 18px;
    background-color: rgb(255, 181, 46);
    border-width: 2px;
    border-color: rgb(29, 20, 5);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

/* 위계 2: 위험 — 중간 크기 코랄 삼각형 (USS 로는 삼각형을 그릴 수 없어 스프라이트) */
.icon--danger {
    left: -15px;
    top: -14px;
    width: 30px;
    height: 28px;
    background-image: resource("Minimap/IconDanger");
    -unity-background-image-tint-color: rgb(255, 106, 92);
}

/* 위계 3: 주변 정보 — 작고 흐린 회청색 사각 점 */
.icon--minor {
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    background-color: rgb(159, 180, 199);
    border-width: 2px;
    border-color: rgb(11, 17, 23);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    opacity: 0.88;
}

/* 단색 두 겹 링 — 바깥 어두운 선(반지름 147~155) + 안쪽 밝은 선(146.5~149) */
.minimap__ring {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 310px;
    height: 310px;
    border-width: 8px;
    border-color: rgba(6, 10, 14, 0.9);
    border-top-left-radius: 155px;
    border-top-right-radius: 155px;
    border-bottom-left-radius: 155px;
    border-bottom-right-radius: 155px;
}

.minimap__ring-inner {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 298px;
    height: 298px;
    border-width: 2.5px;
    border-color: rgba(232, 238, 242, 0.92);
    border-top-left-radius: 149px;
    border-top-right-radius: 149px;
    border-bottom-left-radius: 149px;
    border-bottom-right-radius: 149px;
}

.minimap__player {
    position: absolute;
    left: 128px;
    top: 128px;
    width: 44px;
    height: 44px;
    background-image: resource("Minimap/PlayerArrow");
    transform-origin: center;
}

.edge {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    overflow: visible;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* 원 안 ↔ 가장자리 전환은 150ms 페이드만 (위치는 매 프레임 C# 에서) */
.edge--on {
    opacity: 1;
}

/* 범위 밖 표시: 크기를 줄이고 속이 빈 고리로 모양을 바꿔 '원 안의 실제 위치'와 구분한다 */
.edge__ring {
    position: absolute;
    left: -15px;
    top: -15px;
    width: 30px;
    height: 30px;
    border-width: 4px;
    border-color: rgb(255, 181, 46);
    background-color: rgba(13, 17, 10, 0.75);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    align-items: center;
    justify-content: center;
}

.edge__dot {
    width: 10px;
    height: 10px;
    background-color: rgb(255, 181, 46);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

/* 위를 향한 쐐기 스프라이트 — C# 에서 바깥 방향으로 rotate */
.edge__wedge {
    position: absolute;
    left: -11px;
    top: -13px;
    width: 22px;
    height: 26px;
    background-image: resource("Minimap/EdgeWedge");
    -unity-background-image-tint-color: rgb(255, 181, 46);
    transform-origin: center;
}

.edge__dist {
    position: absolute;
    left: -45px;
    top: -18px;
    width: 90px;
    height: 36px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(242, 245, 248);
    background-color: rgba(8, 12, 18, 0.78);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 181, 46);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* N: 테두리를 따라 위치만 움직이고 글자는 늘 바로 선다 (rotate 를 주지 않는다) */
.minimap__north {
    position: absolute;
    left: 129px;
    top: 129px;
    width: 42px;
    height: 42px;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgb(11, 17, 23);
    border-width: 3px;
    border-color: rgb(232, 238, 242);
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-left-radius: 21px;
    border-bottom-right-radius: 21px;
}
