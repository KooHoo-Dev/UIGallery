<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="PopupManager.uss" />
    <!-- 레이어 순서 = 형제 순서 (뒤에 오는 형제가 위에 그려진다). 창(.popup)은 전체 화면 투명 틀이고
         실제 판(.popup__panel)만 클릭을 받는다 → 판 바깥 클릭은 그 아래의 딤이 받는다. -->
    <ui:VisualElement name="popup-root" class="popup-root" picking-mode="Ignore">

        <ui:VisualElement name="normal-layer" class="layer" picking-mode="Ignore">
            <ui:VisualElement name="notice" class="popup" picking-mode="Ignore">
                <ui:VisualElement class="popup__panel">
                    <ui:Label class="popup__title" text="점검 예고" />
                    <ui:Label class="popup__body" text="내일 04:00 ~ 06:00 동안 서버 점검이 있습니다. 점검 중에는 탐사 보상을 받을 수 없습니다." />
                    <ui:VisualElement class="popup__buttons">
                        <ui:Button name="notice-ok" class="btn btn--primary" text="확인" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="buy" class="popup" picking-mode="Ignore">
                <ui:VisualElement class="popup__panel popup__panel--small">
                    <ui:Label class="popup__title" text="구매 확인" />
                    <ui:Label class="popup__body" text="냉각 셀 ×5 를 구매할까요?  크레딧 12,400 → 11,900" />
                    <ui:VisualElement class="popup__buttons">
                        <ui:Button name="buy-cancel" class="btn" text="취소" />
                        <ui:Button name="buy-confirm" class="btn btn--primary" text="구매" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="dismantle" class="popup" picking-mode="Ignore">
                <ui:VisualElement class="popup__panel popup__panel--small">
                    <ui:Label class="popup__title" text="분해 확인" />
                    <ui:Label class="popup__body" text="회로 조각 ×12 를 분해합니다. 분해한 아이템은 되돌릴 수 없습니다." />
                    <ui:VisualElement class="popup__buttons">
                        <ui:Button name="dismantle-cancel" class="btn" text="취소" />
                        <!-- Button 이 아닌 VisualElement — Button 의 Clickable 이 포인터 이벤트를 먼저 소비하지 않게 -->
                        <ui:VisualElement name="hold" class="btn btn--danger hold" focusable="true">
                            <ui:VisualElement name="hold-fill" class="hold__fill" picking-mode="Ignore" />
                            <ui:Label class="hold__label" text="길게 눌러 분해" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="reward" class="popup" picking-mode="Ignore">
                <ui:VisualElement class="popup__panel popup__panel--small">
                    <ui:Label class="popup__title" text="탐사 보상" />
                    <ui:Label class="popup__body" text="끊기기 전에 끝난 탐사의 보상이 도착했습니다. 회로 조각 ×3" />
                    <ui:VisualElement class="popup__buttons">
                        <ui:Button name="reward-claim" class="btn btn--primary" text="받기" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="system-layer" class="layer" picking-mode="Ignore">
            <ui:VisualElement name="offline" class="popup" picking-mode="Ignore">
                <ui:VisualElement class="popup__panel popup__panel--small popup__panel--system">
                    <ui:Label class="popup__title" text="연결 끊김" />
                    <ui:Label class="popup__body" text="서버와 연결이 끊겼습니다. 네트워크 상태를 확인한 뒤 다시 시도해 주세요." />
                    <ui:VisualElement class="popup__buttons">
                        <ui:Button name="offline-retry" class="btn btn--primary" text="재시도" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="quit" class="popup" picking-mode="Ignore">
                <ui:VisualElement class="popup__panel popup__panel--small popup__panel--system">
                    <ui:Label class="popup__title" text="게임 종료" />
                    <ui:Label class="popup__body" text="게임을 종료할까요?" />
                    <ui:VisualElement class="popup__buttons">
                        <ui:Button name="quit-cancel" class="btn" text="취소" />
                        <ui:Button name="quit-confirm" class="btn btn--danger" text="종료" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 딤: 맨 위 창의 레이어로 옮겨 그 창 바로 아래(PlaceBehind)에 둔다. 기본 picking-mode(Position)라 클릭을 받는다 -->
        <ui:VisualElement name="dim" class="dim" />
    </ui:VisualElement>
</ui:UXML>
