/* 팝업 관리자 — Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080.
   한글이 네모로 보이면 Panel Settings 의 Text Settings 에 한글 글꼴(Font Asset)을 넣는다.
   USS 에는 box-shadow · filter 가 없다 → 그림자 대신 테두리와 딤 농도로 위계를 만든다.
   열림/닫힘: .popup--open 을 붙였다 떼면 opacity · scale 이 transition 된다.
   display: none 에는 transition 이 없으므로 C# 이 열 때는 display 를 먼저 켜고 다음 프레임에 클래스를,
   닫을 때는 클래스를 먼저 떼고 연출이 끝난 뒤 display 를 끈다. */

.popup-root,
.layer,
.dim,
.popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dim {
    background-color: rgba(3, 8, 14, 0.6);
    display: none;
}

.dim--on {
    display: flex;
}

.popup {
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.92 0.92;
    transition-property: opacity, scale;
    transition-duration: 0.18s, 0.18s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.popup--open {
    opacity: 1;
    scale: 1 1;
}

.popup__panel {
    width: 900px;
    padding: 28px 34px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgb(47, 74, 102);
    background-color: rgb(19, 32, 47);
    transition-property: scale;
    transition-duration: 0.12s;
}

.popup__panel--small {
    width: 740px;
}

/* 시스템 레이어 창은 테두리 색으로 구분 */
.popup__panel--system {
    border-color: rgb(255, 209, 102);
}

.popup__title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(234, 242, 251);
    margin-bottom: 16px;
}

.popup__body {
    font-size: 26px;
    color: rgb(214, 226, 238);
    white-space: normal;
    margin-bottom: 24px;
}

.popup__buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.btn {
    min-width: 190px;
    height: 76px;
    margin-left: 16px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(47, 74, 102);
    background-color: rgb(13, 24, 36);
    color: rgb(234, 242, 251);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    justify-content: center;
}

.btn--primary {
    background-color: rgb(94, 230, 201);
    border-color: rgb(94, 230, 201);
    color: rgb(6, 42, 36);
}

.btn--danger {
    border-color: rgb(255, 122, 107);
    color: rgb(255, 217, 212);
}

/* 키보드·패드 포커스 — 위험한 창은 '취소' 에 기본 포커스 */
.btn:focus {
    border-color: rgb(255, 255, 255);
    border-width: 4px;
}

.hold {
    overflow: hidden;
    padding: 0 28px;
}

.hold__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgba(255, 122, 107, 0.35);
}

.hold__label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 217, 212);
    -unity-text-align: middle-center;
}

/* 바깥 탭으로 닫히지 않을 때 판이 살짝 커졌다 돌아온다 (C# 이 0.12초 뒤 클래스를 뗀다) */
.popup__panel--bump {
    scale: 1.035 1.035;
}
