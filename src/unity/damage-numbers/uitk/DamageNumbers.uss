/* 데미지 숫자 — Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080 기준 픽셀 값.
   USS 에는 calc() · gradient · box-shadow · filter 가 없다. 외곽선은 -unity-text-outline 으로 준다.
   한글 글리프가 있는 Font Asset 을 -unity-font-definition 으로 지정할 것 (예: resource("Fonts/KoreanSDF")) */

:root {
    --dmg-normal: rgb(238, 242, 246);
    --dmg-crit: rgb(255, 180, 60);
    --dmg-break: rgb(200, 140, 255);
    --dmg-heal: rgb(63, 224, 189);
    --dmg-block: rgb(143, 155, 173);
}

.number-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 고정 크기 상자를 음수 margin 으로 당겨 '가운데 아래'가 앵커에 오게 한다.
   translate 는 상승 · 밀어 올림 전용 (C# 에서 매 프레임) */
.dmg {
    position: absolute;
    width: 400px;
    height: 160px;
    margin-left: -200px;
    margin-top: -160px;
    align-items: center;
    justify-content: flex-end;
    transform-origin: 50% 100%;
}

.dmg__value {
    font-size: 50px;
    -unity-font-style: bold;
    color: var(--dmg-normal);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(10, 13, 20);
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.6);
    padding: 0;
    margin: 0;
}

.dmg__badge {
    display: none;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(18, 13, 8);
    padding: 2px 10px;
    margin-bottom: 4px;
    border-radius: 3px;
    border-width: 2px;
    border-color: rgb(10, 13, 20);
    letter-spacing: 2px;
}

/* ───── 범주 수정자 (풀에서 꺼낼 때마다 모두 지우고 다시 붙인다) ───── */
.dmg--crit {
    rotate: -6deg;
}
.dmg--crit .dmg__value {
    font-size: 75px;
    color: var(--dmg-crit);
    -unity-text-outline-width: 3px;
}
.dmg--crit .dmg__badge {
    display: flex;
    background-color: var(--dmg-crit);
}

.dmg--break .dmg__value {
    font-size: 61px;
    color: var(--dmg-break);
    -unity-text-outline-width: 3px;
}
.dmg--break .dmg__badge {
    display: flex;
    background-color: var(--dmg-break);
}

.dmg--heal .dmg__value {
    font-size: 48px;
    color: var(--dmg-heal);
}

.dmg--block .dmg__value {
    font-size: 34px;
    color: var(--dmg-block);
}
.dmg--block .dmg__badge {
    display: flex;
    background-color: var(--dmg-block);
}

/* 형태 단서 끔: 배지 · 기울기 없음 (색만 남는다) */
.dmg--no-cue .dmg__badge {
    display: none;
}
.dmg--no-cue {
    rotate: 0deg;
}

/* ───── 누적 합계 ───── */
.total-counter {
    position: absolute;
    padding: 8px 20px 10px 16px;
    border-left-width: 5px;
    border-color: rgb(255, 207, 110);
    background-color: rgba(8, 12, 22, 0.8);
    translate: 0 -50%;
    transition-property: opacity;
    transition-duration: 0.25s;
}
.total-counter--hidden {
    opacity: 0;
}
.total-counter__caption {
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(255, 217, 138);
    letter-spacing: 3px;
}
.total-counter__row {
    flex-direction: row;
    align-items: flex-end;
}
.total-counter__value {
    font-size: 66px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(10, 13, 20);
}
.total-counter__hits {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(18, 13, 8);
    background-color: rgb(255, 207, 110);
    padding: 2px 10px;
    margin-left: 12px;
    margin-bottom: 10px;
}
