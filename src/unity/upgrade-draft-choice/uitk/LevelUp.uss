/* 레벨업 — Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080.
   한글이 네모로 보이면 Panel Settings 의 Text Settings 에 한글 글꼴(Font Asset)을 넣는다.
   USS transition 은 Time.timeScale 과 상관없이 실제 시간으로 돈다 → timeScale 0 에서도 카드가 올라온다. */

.levelup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.levelup--open {
    display: flex;
}

.levelup__dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 6, 11, 0.7);
}

.levelup__body {
    flex-grow: 1;
    align-items: center;
    padding-top: 130px;
}

.levelup__title {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(234, 242, 251);
}

.lock {
    width: 520px;
    height: 16px;
    margin: 16px 0;
    border-radius: 8px;
    background-color: rgb(11, 22, 34);
    overflow: hidden;
}

.lock__fill {
    height: 100%;
    width: 0;
    background-color: rgba(94, 230, 201, 0.4);
}

.cards {
    flex-direction: row;
}

.card {
    width: 360px;
    height: 470px;
    margin: 0 18px;
    padding: 26px 24px 22px;
    border-radius: 22px;
    border-width: 4px;
    border-color: rgb(183, 199, 216);
    background-color: rgb(17, 30, 46);
    align-items: center;
    opacity: 0;
    translate: 0 40px;
    transition-property: opacity, translate, scale;
    transition-duration: 0.24s, 0.24s, 0.2s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out;
}

.card--in {
    opacity: 1;
    translate: 0 0;
}

.card--gone {
    opacity: 0.25;
}

.card--picked {
    scale: 1.06 1.06;
}

/* Button 기본 테마의 :hover · :active 배경색을 덮는다 — 안 그러면 카드 위에 올리거나 누를 때 회색으로 바뀐다 */
.card:hover,
.card:active {
    background-color: rgb(17, 30, 46);
}

.card:focus {
    border-color: rgb(255, 255, 255);
}

.card--rare { border-color: rgb(111, 182, 255); }
.card--epic { border-color: rgb(255, 179, 71); }

.card__head {
    flex-direction: row;
    align-self: stretch;
    align-items: center;
}

/* 모양: 일반 = 원, 희귀 = 마름모(45° 회전한 사각), 영웅 = 별 이미지 */
.card__shape {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    background-color: rgb(183, 199, 216);
    border-radius: 9px;
}

.card--rare .card__shape {
    border-radius: 0;
    rotate: 45deg;
    background-color: rgb(111, 182, 255);
}

.card--epic .card__shape {
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 179, 71);
    /* background-image: resource("Icons/star"); — 별 모양 이미지 */
}

.card__rarity {
    flex-grow: 1;
    font-size: 22px;
    -unity-font-style: bold;
}

.card__kind {
    font-size: 22px;
    padding: 0 10px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.1);
}

.card__icon {
    width: 130px;
    height: 130px;
    margin-top: 30px;
}

.card__name {
    font-size: 32px;
    -unity-font-style: bold;
    margin-top: 12px;
}

.card__level {
    font-size: 26px;
    -unity-font-style: bold;
}

.card__diff {
    margin-top: auto;
    padding: 10px 14px;
    border-radius: 12px;
    background-color: rgb(5, 10, 16);
    font-size: 24px;
    white-space: normal;
}

.actions {
    flex-direction: row;
    margin-top: 20px;
}

.action {
    height: 64px;
    padding: 0 22px;
    margin: 0 8px;
    font-size: 24px;
}
