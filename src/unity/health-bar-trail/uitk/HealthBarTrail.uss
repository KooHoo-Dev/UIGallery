/* Panel Settings: Scale With Screen Size, Reference Resolution 1920×1080 기준 픽셀 값 */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 저체력 테두리 — USS 는 radial-gradient 를 지원하지 않으므로
   가장자리만 불투명한 텍스처를 Resources 폴더에 두고 사용한다 */
.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    background-image: resource("LowHealthVignette");
    -unity-background-scale-mode: stretch-to-fill;
}

.hb {
    position: absolute;
    left: 96px;
    bottom: 92px;
    width: 660px;
    height: 34px;
    background-color: rgba(6, 9, 15, 0.72);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.85);
    overflow: hidden;
}

.hb__layer {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.hb__trail {
    background-color: rgb(244, 178, 60);
}

.hb__heal {
    background-color: rgba(160, 255, 190, 0.7);
}

.hb__fill {
    background-color: rgb(80, 220, 110);
}

.hb-label {
    position: absolute;
    left: 96px;
    bottom: 136px;
    font-size: 28px;
    color: rgb(244, 247, 251);
    -unity-font-style: bold;
}
